[TEMPLATE]
# Supabase project config — copy this file to .env.local and fill in values.
# Get these from your Supabase project: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: used for password reset redirect links and the logo URL inside
# welcome emails (defaults to http://localhost:3000). Set to your deployed
# domain on Vercel (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — registration confirmation (welcome) email.
# Get the API key from https://resend.com/api-keys. Keep it server-side;
# never expose it via NEXT_PUBLIC_*.
# In development you can use the shared sender "onboarding@resend.dev"
# (only delivers to the account owner's email). For production, add and
# verify your own sending domain in Resend, then use e.g.
# "Christ-Core LMS <no-reply@yourdomain.com>".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Christ-Core LMS <onboarding@resend.dev>
