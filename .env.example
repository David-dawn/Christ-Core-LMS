[TEMPLATE]
[TEMPLATE]
# Supabase project config — copy this file to .env.local and fill in values.
# Get these from your Supabase project: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: used for the logo URL inside welcome emails (defaults to the
# request origin, or http://localhost:3000 locally). Set to your deployed
# domain on Vercel (e.g. https://your-app.vercel.app) for a stable URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo — registration confirmation (welcome) email.
# Get the API key from https://app.brevo.com/settings/keys/api
# (SMTP & API → API keys → "Manage API keys"). Keep it server-side; never
# expose it via NEXT_PUBLIC_*.
# EMAIL_FROM must be a sender YOU VERIFIED in Brevo (Brevo → Senders → Add a
# sender; you verify it with a 6-digit code sent to that address — no custom
# domain required). The free plan allows 300 sends/day. Example:
#   EMAIL_FROM=Christ-Core LMS <you@example.com>
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Christ-Core LMS <you@example.com>
